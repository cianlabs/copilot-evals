# Virtual environments
.venv/
venv/
env/

# The pinned runbook-copilot checkout this harness downloads
.vendor/

# The unmerged graph branch, downloaded so the comparison can run.
# Do not commit that copy.
.vendor-graph/

# Collected runs. Commit runs.sample.jsonl, not a fresh pass.
runs.jsonl
*.runs.jsonl

# Step-by-step traces from collect_runs.py --trace. Local only.
traces.jsonl

# Real-model passes. Kept apart from the practice files.
runs.real.jsonl
traces.real.jsonl

# Judge output. Written by judge.py. Do not commit it.
judge_results.jsonl

# Key and secret files
.env
.env.*
*.key
*.pem
secrets/

# Python junk
__pycache__/
*.pyc
.pytest_cache/

# Tool-call log, if a checkout writes one next to the harness
agent.log

# macOS
.DS_Store
